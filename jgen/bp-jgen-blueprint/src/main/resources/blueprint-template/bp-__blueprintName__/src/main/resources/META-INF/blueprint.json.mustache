{
  "initHook" : "org.chenile.jgen.blueprint.{{blueprintName}}.Init{{BlueprintName}}Blueprint",
  "name" : "{{blueprintName}}",
  "description" : "Generates a {{BlueprintName}} project",
  "templateFolder": "{{blueprintName}}-template",
  "inputFields" :[
    {
      "name" : "projectName",
      "type" : "STRING",
      "description": "Name of the project to generate",
      "validation" : "PROJECT_NAME"
    },
    {
      "name" : "projectVersion",
      "type" : "STRING",
      "description": "Version of the generated project",
      "defaultValue" : "${defaultVersion}",
      "validation" : "VERSION"
    },
    {
      "name" : "destFolder",
      "type" : "STRING",
      "description": "Destination Folder",
      "defaultValue" : "${defaultDestFolder}"
    },
    {
      "name" : "includeExtras",
      "type" : "BOOLEAN",
      "description": "Include the optional extras folder",
      "defaultValue" : "n"
    }
    {{#jpa}}
    ,{
        "name" : "jpa",
        "type" : "BOOLEAN",
        "description": "Enable JPA",
        "defaultValue" : "y"
    }
    {{/jpa}}
    {{#cloudSwitchEnabled}}
    ,
    {
        "name" : "cloudSwitchEnabled",
        "type" : "BOOLEAN",
        "description": "Enable Cloud Switch",
        "defaultValue" : "n"
    }
    {{/cloudSwitchEnabled}}
    {{#security}}
    ,
    {
        "name" : "security",
        "type" : "BOOLEAN",
        "description": "Enable Security",
        "defaultValue" : "n"
    }
    {{/security}}
  ]
}
