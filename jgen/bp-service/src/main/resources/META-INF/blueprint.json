{
  "initHook": "org.chenile.jgen.blueprint.service.InitServiceBlueprint",
  "name": "chenile-service",
  "description": "Generates a Chenile Service",
  "templateFolder": "service-template",
  "inputFields": [
    {
      "name": "service",
      "type": "STRING",
      "description": "Name of Service",
      "defaultValue": "${defaultServiceName}",
      "validation": "JAVA_IDENTIFIER"
    },
    {
      "name": "serviceVersion",
      "type": "STRING",
      "description": "Service Version",
      "defaultValue": "${defaultVersion}",
      "validation": "VERSION"
    },
    {
      "name": "destFolder",
      "type": "STRING",
      "description": "Destination Folder",
      "defaultValue": "${defaultDestFolder}"
    },
    {
      "name": "security",
      "type": "BOOLEAN",
      "description": "Enable Security",
      "defaultValue": "n"
    },
    {
      "name": "jpa",
      "type": "BOOLEAN",
      "description": "Enable JPA",
      "defaultValue": "y"
    },
    {
      "name": "cloudSwitchEnabled",
      "type": "BOOLEAN",
      "description": "Enable Cloud Switch",
      "defaultValue": "n"
    },
    {
      "name": "enableMCP",
      "type": "BOOLEAN",
      "description": "Enable MCP support",
      "defaultValue": "n"
    },
    {
      "name": "super_pom",
      "type": "SuperPOM",
      "description": "Optional parent POM for the generated project",
      "required": false,
      "helpText": "Object with groupId, artifactId, version and relativePath. Omit to keep the blueprint parent."
    },
    {
      "name": "dependencies",
      "type": "POM_Dependencies",
      "description": "Additional Maven dependencies",
      "required": false,
      "helpText": "Added to __service__/__service__-service/pom.xml. Versions may be omitted when supplied by dependency management."
    }
  ]
}
