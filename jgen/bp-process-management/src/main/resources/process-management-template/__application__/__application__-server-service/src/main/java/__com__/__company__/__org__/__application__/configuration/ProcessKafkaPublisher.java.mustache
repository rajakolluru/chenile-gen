package {{packageName}}.configuration;

import org.chenile.pubsub.ChenilePub;
import org.apache.kafka.clients.producer.ProducerRecord;
import org.apache.kafka.common.header.internals.RecordHeader;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.context.annotation.*;
import java.nio.charset.StandardCharsets;
import java.util.Map;
import java.util.concurrent.TimeUnit;

/** Wait for broker acknowledgement so failed sends keep their outbox command retryable. */
@Configuration
public class ProcessKafkaPublisher {
    @Bean
    public ChenilePub chenilePub(KafkaTemplate<String, String> kafka) {
        return new ChenilePub() {
            public void publishToOperation(
                    String service, String operation, String payload, Map<String, Object> headers) {
                publish(service + "_" + operation, payload, headers);
            }

            public void asyncPublish(String topic, String payload, Map<String, Object> headers) {
                publish(topic, payload, headers);
            }

            public void publish(String topic, String payload, Map<String, Object> headers) {
                var record = new ProducerRecord<String, String>(topic, null, payload);
                headers.forEach(
                        (key, value) -> {
                            if (key.startsWith("x-") && value != null) {
                                record.headers()
                                        .add(
                                                new RecordHeader(
                                                        key,
                                                        value.toString()
                                                                .getBytes(StandardCharsets.UTF_8)));
                            }
                        });
                try {
                    kafka.send(record).get(30, TimeUnit.SECONDS);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    throw new IllegalStateException("Kafka publication interrupted", e);
                } catch (Exception e) {
                    throw new IllegalStateException("Kafka publication failed", e);
                }
            }
        };
    }
}
