package {{packageName}}.bootstrap;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.chenile.core.context.ContextContainer;
import org.chenile.orchestrator.process.config.model.ProcessDef;
import org.chenile.orchestrator.process.config.reader.ProcessConfigurator;
import org.chenile.orchestrator.process.configuration.dao.ProcessDefinitionRepository;
import org.chenile.orchestrator.process.configuration.model.ProcessDefinition;
import org.chenile.orchestrator.process.service.defs.DatabaseProcessConfigurator;
import org.chenile.scheduler.db.ScheduleService;
import org.chenile.scheduler.db.SchedulerDefinitionEntity;
import org.chenile.scheduler.db.SchedulerDefinitionRepository;
import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.core.Ordered;
import org.springframework.transaction.support.TransactionTemplate;
import org.springframework.transaction.PlatformTransactionManager;

/**
 * Seeds missing process definitions and schedules only. Restarts never overwrite administrator edits. Created as a bean in
 * {@code {{Application}}ProcessConfiguration}; it runs before every other ApplicationRunner.
 */
public class GeneratedProcessBootstrap implements ApplicationRunner, Ordered {
    private final ProcessConfigurator configurator;
    private final ProcessDefinitionRepository definitions;
    private final SchedulerDefinitionRepository schedules;
    private final ScheduleService scheduleService;
    private final ObjectMapper json;
    private final TransactionTemplate transactions;
    public GeneratedProcessBootstrap(
            ProcessConfigurator configurator,
            ProcessDefinitionRepository definitions,
            SchedulerDefinitionRepository schedules,
            ScheduleService scheduleService,
            ObjectMapper json,
            PlatformTransactionManager manager) {
        this.configurator = configurator;
        this.definitions = definitions;
        this.schedules = schedules;
        this.scheduleService = scheduleService;
        this.json = json;
        this.transactions = new TransactionTemplate(manager);
    }
    @Override public int getOrder() {
        return Ordered.HIGHEST_PRECEDENCE;
    }

    @Override public void run(ApplicationArguments args) throws Exception {
        try (var stream = getClass().getResourceAsStream("/{{application}}/defs.json")) {
            var source = configurator instanceof DatabaseProcessConfigurator ? new ProcessConfigurator() : configurator;
            source.read(stream);
            if (configurator instanceof DatabaseProcessConfigurator database) {
                // Flush all levels in one transaction before invalidating the definition cache.
                transactions.executeWithoutResult(
                        tx ->
                                source.processes.processMap.forEach(
                                        (name, definition) -> {
                                            if (!definitions.existsById(name)) {
                                                definitions.save(
                                                        new ProcessDefinition(
                                                                name, serialize(definition)));
                                            }
                                        }));
                database.clearCache();
            }
        }
        try (var stream = getClass().getResourceAsStream("/{{application}}/schedules.json")) {
            for (JsonNode node : json.readTree(stream)) {
                SchedulerDefinitionEntity schedule = toSchedule(node);
                boolean exists = schedules.findByTenant(schedule.tenant).stream()
                        .anyMatch(existing -> existing.name.equals(schedule.name));
                if (exists) continue;
                // ScheduleService saves in the caller's tenant: seed each schedule as its own tenant.
                var context = ContextContainer.CONTEXT_CONTAINER;
                var snapshot = context.snapshot();
                try {
                    context.setTenant(schedule.tenant);
                    scheduleService.save(schedule);
                } finally {
                    context.restore(snapshot);
                }
            }
        }
    }

    private SchedulerDefinitionEntity toSchedule(JsonNode node) {
        SchedulerDefinitionEntity schedule = new SchedulerDefinitionEntity();
        schedule.name = node.path("name").asText();
        schedule.tenant = node.path("tenant").asText();
        schedule.enabled = node.path("enabled").asBoolean(true);
        schedule.cronExpression = node.path("cronExpression").asText();
        schedule.timezone = node.path("timezone").asText("UTC");
        schedule.eventId = node.path("eventId").asText("ProcessCreate");
        schedule.description = node.hasNonNull("description") ? node.get("description").asText() : null;
        schedule.payload = node.get("payload").toString();
        return schedule;
    }
    private String serialize(ProcessDef definition) {
        try { return json.writeValueAsString(definition); }
        catch (JsonProcessingException e) {
            throw new IllegalStateException("Cannot serialize " + definition.processType, e);
        }
    }
}
