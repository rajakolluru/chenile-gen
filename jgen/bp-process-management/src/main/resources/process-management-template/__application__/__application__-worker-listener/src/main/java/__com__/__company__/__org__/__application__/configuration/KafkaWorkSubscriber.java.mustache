package {{packageName}}.configuration;
import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.chenile.core.context.*;
import org.chenile.core.event.EventProcessor;
import org.springframework.kafka.annotation.KafkaListener;
import java.nio.charset.StandardCharsets;
import java.util.*;
public class KafkaWorkSubscriber {
 private final EventProcessor events;
 public KafkaWorkSubscriber(EventProcessor events) { this.events = events; }
 @KafkaListener(topics="#{'${process.work.topics}'.split(',')}", groupId="${process.work.consumer-group}")
 public void receive(ConsumerRecord<String,String> record) {
  var context = ContextContainer.CONTEXT_CONTAINER; var snapshot = context.snapshot();
  try {
   Map<String,String> headers = new HashMap<>();
   record.headers().forEach(header -> { if (header.key().startsWith("x-")) headers.put(header.key(), new String(header.value(), StandardCharsets.UTF_8)); });
   String tenant = headers.get(HeaderUtils.TENANT_ID_KEY);
   if (tenant == null || tenant.isBlank()) throw new IllegalArgumentException("Missing tenant header");
   context.setTenant(tenant);
   var results = events.handleEvent("process-work", record.value(), headers);
   if (results.isEmpty()) throw new IllegalStateException("No process-work subscriber");
   for (var result : results) if (result.getException() != null) throw new IllegalStateException("Worker delivery failed", result.getException());
  } finally { context.restore(snapshot); }
 }
}
