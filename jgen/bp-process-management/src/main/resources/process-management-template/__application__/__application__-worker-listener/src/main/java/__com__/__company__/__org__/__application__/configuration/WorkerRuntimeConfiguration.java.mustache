package {{packageName}}.configuration;

import org.chenile.orchestrator.configuration.DelegateConfiguration;
import org.chenile.pubsub.configuration.PubSubConfiguration;
import org.chenile.pubsub.kafka.configuration.CustomKafkaConsumer;
import org.chenile.pubsub.kafka.configuration.KafkaConfiguration;
import org.chenile.pubsub.kafka.configuration.KafkaConsumerConfig;
import org.chenile.pubsub.kafka.configuration.KafkaProducerConfig;
import org.springframework.context.annotation.*;

@Configuration
@Import({
    DelegateConfiguration.class,
    PubSubConfiguration.class,
    KafkaConfiguration.class,
    KafkaProducerConfig.class,
    KafkaConsumerConfig.class,
    CustomKafkaConsumer.class
})
public class WorkerRuntimeConfiguration {
    @Bean
    public ProcessWorkListener processWorkListener() {
        return new ProcessWorkListener();
    }

}
