package {{packageName}}.worker;

import {{packageName}}.model.*;
import org.chenile.orchestrator.process.model.WorkerDto;
import org.chenile.orchestrator.process.model.payload.SubProcessPayload;
import org.chenile.orchestrator.process.utils.base.SplitterBase;
import java.util.ArrayList;
import java.util.List;

public class {{name}}Splitter extends SplitterBase<{{inputType}},Object> {
{{#fileSplit}}
    private final FileWork files;
    public {{name}}Splitter(FileWork files) { this.files = files; }
{{/fileSplit}}
    @Override protected List<SubProcessPayload> doStart(WorkerDto worker, {{inputType}} input) {
{{#fileSplit}}
        var result = new ArrayList<SubProcessPayload>();
        int bytes = Integer.parseInt(worker.execDef.getOrDefault("chunkBytes", "1048576"));
        for (String filename : files.split(input.filename, worker.process.id, bytes)) {
{{#children}}
            var child = new {{inputType}}(); child.filename = filename;
            result.add(makeSubProcessPayload(child, "{{name}}"));
{{/children}}
        }
        return result;
{{/fileSplit}}
