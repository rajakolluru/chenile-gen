package {{packageName}}.worker;

import {{packageName}}.model.*;
import org.chenile.orchestrator.process.model.WorkerDto;
import org.chenile.orchestrator.process.model.Process;
import org.chenile.orchestrator.process.utils.base.AggregatorBase;

/** Runs once every direct child is terminal, including failed children. */
public class {{name}}Aggregator extends AggregatorBase<{{inputType}},ProcessResult,ProcessResult> {
    @Override protected ProcessResult doStart(ProcessResult out, {{inputType}} input,
            ProcessResult childOutput, WorkerDto worker, Process child) {
        if (out == null) out = new ProcessResult();
        out.completedChildren++;
        if (childOutput != null) out.bytesProcessed += childOutput.bytesProcessed;
        if (!child.errors.isEmpty()) {
            out.failedChildren++;
            for (var error : child.errors) {
                out.errors.add(child.processType + ":" + child.id + ": " + error.exceptionMessage);
                if (error.errors != null) out.errors.addAll(error.errors);
            }
        }
        return out;
    }
}
