        // Supported children:
{{#children}}
        // {{name}} accepts {{inputType}}
{{/children}}
        // SplitterBase reports splitDone/splitDoneWithErrors and the manager starts the children.
        throw new UnsupportedOperationException("Implement {{name}}Splitter.doStart");
{{/custom}}
    }
}
