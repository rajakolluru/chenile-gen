import {{packageName}}.api.{{name}}Service;
import {{packageName}}.model.{{inputType}};
import org.chenile.orchestrator.process.model.Process;

public class {{name}}ServiceImpl implements {{name}}Service {
    private final ProcessWorkers workers;
    public {{name}}ServiceImpl(ProcessWorkers workers) { this.workers = workers; }
