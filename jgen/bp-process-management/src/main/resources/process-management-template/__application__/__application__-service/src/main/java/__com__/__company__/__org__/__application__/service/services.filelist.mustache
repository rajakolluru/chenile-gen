package {{packageName}}.service;

import org.chenile.core.context.ContextContainer;
import org.chenile.orchestrator.process.model.WorkerDto;
import org.chenile.orchestrator.process.utils.base.BatchServiceBase;

/** One BatchService routes every level using the framework processType + workerType convention. */
public class ProcessWorkers extends BatchServiceBase<Object> {
    @Override protected String getTenant() { return ContextContainer.CONTEXT_CONTAINER.getTenant(); }
    @Override public boolean startWorker(WorkerDto dto) {
        var context = ContextContainer.CONTEXT_CONTAINER;
        var snapshot = context.snapshot();
        try {
            context.setTenant(dto.process.tenant);
            return super.startWorker(dto);
        } finally { context.restore(snapshot); }
    }
}
--END--
