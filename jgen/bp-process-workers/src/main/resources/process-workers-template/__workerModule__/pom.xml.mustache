<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    {{#parentArtifactId}}
        <parent>
            <groupId>{{parentGroupId}}</groupId>
            <artifactId>{{parentArtifactId}}</artifactId>
            <version>{{parentVersion}}</version>
            <relativePath>{{parentRelativePath}}</relativePath>
        </parent>
    {{/parentArtifactId}}
    {{^parentArtifactId}}
        <parent>
            <groupId>{{chenilePackage}}</groupId>
            <artifactId>chenile-parent</artifactId>
            <version>{{chenileVersion}}</version>
        </parent>
    {{/parentArtifactId}}
    <groupId>{{packageName}}</groupId>
    <artifactId>{{workerModule}}</artifactId>
    <version>{{applicationVersion}}</version>
    <dependencies>
        <dependency>
            <groupId>org.chenile.orchestrator.process</groupId>
            <artifactId>process-delegate</artifactId>
            <version>{{chenileVersion}}</version>
        </dependency>
        {{#dependencies}}
            <dependency>
                <groupId>{{groupId}}</groupId>
                <artifactId>{{artifactId}}</artifactId>{{#version}}
                <version>{{version}}</version>{{/version}}</dependency>{{/dependencies}}
    </dependencies>
</project>
