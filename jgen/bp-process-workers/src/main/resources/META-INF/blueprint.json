{
  "name": "chenile-process-workers",
  "description": "API and service JARs for one process type: typed input/output API and executor or splitter/aggregator service",
  "sinceVersion": "2.1.32",
  "initHook": "org.chenile.jgen.blueprint.workers.InitProcessWorkersBlueprint",
  "templateFolder": "process-workers-template",
  "inputFields": [
    {
      "name": "workerModule",
      "type": "STRING",
      "description": "workerModule",
      "validation": "PROJECT_NAME"
    },
    {
      "name": "application",
      "type": "STRING",
      "description": "application",
      "validation": "JAVA_IDENTIFIER"
    },
    {
      "name": "applicationVersion",
      "type": "STRING",
      "description": "applicationVersion",
      "defaultValue": "${defaultVersion}",
      "validation": "VERSION"
    },
    {
      "name": "packageName",
      "type": "STRING",
      "description": "packageName",
      "validation": "JAVA_PACKAGE"
    },
    {
      "name": "processType",
      "type": "STRING",
      "description": "processType",
      "validation": "JAVA_IDENTIFIER"
    },
    {
      "name": "name",
      "type": "STRING",
      "description": "name",
      "validation": "JAVA_IDENTIFIER"
    },
    {
      "name": "inputType",
      "type": "STRING",
      "description": "inputType",
      "validation": "JAVA_IDENTIFIER"
    },
    {
      "name": "fields",
      "type": "RECORD_ARRAY",
      "description": "Typed input fields",
      "required": false,
      "childFields": [
        {"name": "name", "type": "STRING", "description": "field name", "validation": "JAVA_IDENTIFIER"},
        {"name": "javaType", "type": "STRING", "description": "field Java type", "validation": "JAVA_TYPE"}
      ]
    },
    {
      "name": "outputType",
      "type": "STRING",
      "description": "outputType",
      "required": true
    },
    {
      "name": "childOutputType",
      "type": "STRING",
      "description": "childOutputType",
      "required": false
    },
    {
      "name": "outputFields",
      "type": "RECORD_ARRAY",
      "description": "outputFields",
      "required": false,
      "childFields": [
        {"name": "name", "type": "STRING", "description": "field name", "validation": "JAVA_IDENTIFIER"},
        {"name": "javaType", "type": "STRING", "description": "field Java type", "validation": "JAVA_TYPE"}
      ]
    },
    {
      "name": "apiArtifact",
      "type": "STRING",
      "description": "API artifactId",
      "validation": "PROJECT_NAME"
    },
    {
      "name": "serviceArtifact",
      "type": "STRING",
      "description": "service artifactId",
      "validation": "PROJECT_NAME"
    },
    {
      "name": "leaf",
      "type": "BOOLEAN",
      "description": "leaf",
      "defaultValue": "y"
    },
    {
      "name": "children",
      "type": "RECORD_ARRAY",
      "description": "children",
      "required": false,
      "childFields": [
        {
          "name": "name",
          "type": "STRING",
          "description": "name",
          "validation": "JAVA_IDENTIFIER"
        },
        {
          "name": "inputType",
          "type": "STRING",
          "description": "inputType",
          "validation": "JAVA_IDENTIFIER"
        },
        {"name": "childApiArtifact", "type": "STRING", "description": "child API artifact", "validation": "PROJECT_NAME"}
      ]
    },
    {
      "name": "destFolder",
      "type": "STRING",
      "description": "destFolder",
      "defaultValue": "${defaultDestFolder}"
    },
    {
      "name": "super_pom",
      "type": "SuperPOM",
      "description": "super_pom",
      "required": false
    },
    {
      "name": "dependencies",
      "type": "POM_Dependencies",
      "description": "dependencies",
      "required": false
    }
  ]
}
